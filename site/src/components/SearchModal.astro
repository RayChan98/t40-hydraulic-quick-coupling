---
import { ui } from '../i18n/ui';
const lang = Astro.url.pathname.startsWith('/es') ? 'es' : 'en';
const D = ui[lang];

// 搜索弹窗（istamping 模式）：点击放大镜弹出，大输入框 + 热门词 + ESC/遮罩关闭
const popular = [
  { label: 'ISO 7241 Quick Couplings', href: '/iso-7241-hydraulic-quick-couplings/' },
  { label: 'Flat Face Couplings', href: '/flat-face-hydraulic-couplings/' },
  { label: 'Agricultural Couplings', href: '/agricultural-hydraulic-couplings/' },
  { label: 'ISO Interchange Guide', href: '/blog/iso-7241-vs-iso-16028-vs-iso-5675/' },
  { label: 'Leaking Fixes', href: '/blog/hydraulic-quick-disconnect-leaking-fixes/' },
];
---

<!-- 搜索弹窗 -->
<div id="search-modal" class="fixed inset-0 z-[190] hidden items-start justify-center p-4 pt-[18vh]" data-search-modal aria-hidden="true">
  <!-- 遮罩 -->
  <div class="absolute inset-0 bg-navy-950/70 backdrop-blur-sm" data-search-close></div>
  <!-- 面板 -->
  <div class="relative w-full max-w-xl rounded-2xl bg-white p-6 shadow-2xl sm:p-8">
    <button type="button" class="absolute right-4 top-4 rounded-full p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-navy-950" data-search-close aria-label="Close search">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
    </button>

    <p class="text-sm font-bold text-navy-950">{lang === 'es' ? 'Buscar' : 'Search'}</p>
    <p class="mt-1 text-xs text-slate-500">Find ISO quick couplings, guides and maintenance content across Hydraulic Quick Couplings.</p>

    <div class="mt-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">{D.popularSearches}</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {popular.map((p) => (
          <a href={p.href} class="rounded-full border border-slate-200 px-3 py-1.5 text-xs text-slate-600 transition hover:border-brand-blue hover:text-brand-blue">{p.label}</a>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('search-modal');
  const openers = document.querySelectorAll('[data-search-open]');
  const closers = modal ? modal.querySelectorAll('[data-search-close]') : [];
  const input = modal ? modal.querySelector('input[type="search"]') : null;

  function openModal() {
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
    input?.focus();
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  openers.forEach((btn) => btn.addEventListener('click', (e) => { e.preventDefault(); openModal(); }));
  closers.forEach((btn) => btn.addEventListener('click', closeModal));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
</script>
