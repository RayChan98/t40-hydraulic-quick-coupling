---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FloatingActions from '../components/FloatingActions.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import InquiryModal from '../components/InquiryModal.astro';
import SearchModal from '../components/SearchModal.astro';

const SITE = 'https://hydraulic-quick-couplings.pages.dev';
const { title = 'Hydraulic Quick Couplings — ISO 7241 / ISO 16028 / ISO 5675', description = 'Hydraulic quick coupling specialists. ISO 7241-1 Series A & B, ISO 16028 flat face and ISO 5675 agricultural quick couplings with selection and interchange support for distributors, OEMs and maintenance teams.' } = Astro.props;
const canonical = Astro.url.pathname === '/' ? `${SITE}/` : `${SITE}${Astro.url.pathname.replace(/\/$/, '')}/`;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Hydraulic Quick Couplings',
  url: `${SITE}/`,
  description: 'Hydraulic quick coupling supply: ISO 7241-1 Series A/B, ISO 16028 flat-face, ISO 5675 agricultural. Selection and interchange guidance.',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <SiteHeader />
    <main class="flex-1">
      <slot />
    </main>
    <SiteFooter />
    <FloatingActions />
    <MobileBottomNav />
    <InquiryModal />
    <SearchModal />
  </body>
</html>
