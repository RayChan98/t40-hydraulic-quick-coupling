---
import Layout from '../../../layouts/Layout.astro';
---
<Layout title="Ray Chan — Author | Hydraulic Quick Couplings" description="Ray Chan — hydraulic quick coupling sourcing specialist and author of the Hydraulic Quick Couplings buyer's guides.">
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <div class="flex items-center gap-5">
        <span class="grid h-16 w-16 place-items-center rounded-full bg-brand-blue text-xl font-bold text-white">RC</span>
        <div>
          <h1 class="text-3xl font-extrabold tracking-tight">Ray Chan</h1>
          <p class="mt-1 text-slate-300">Hydraulic quick coupling sourcing specialist</p>
        </div>
      </div>
    </div>
  </section>
  <section class="bg-white">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
      <p class="text-base leading-relaxed text-slate-600">
        Ray helps distributors, OEMs and maintenance teams find the right ISO 7241 / ISO 16028 / ISO 5675 couplings and replacement parts — matching profiles, sizes and threads correctly the first time. The guides on this site cover what Ray answers daily in quotes: interchangeability, identification, thread selection and maintenance.
      </p>
      <a href="/contact/" class="mt-8 inline-flex items-center rounded-lg bg-cta-orange px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-orange-600">Ask Ray a Question</a>
    </div>
  </section>
</Layout>
