---
import Layout from '../../layouts/Layout.astro';
const posts = [
  { href: '/blog/iso-7241-series-a-vs-series-b/', title: 'ISO 7241 Series A vs Series B: What\'s the Difference?', desc: 'The two ISO 7241 profiles compared — interchange families, 60-second identification, ordering mistakes.', time: '8 min' },
  { href: '/blog/npt-vs-bspp-vs-bspt-vs-jic-vs-orfs/', title: 'Hydraulic Coupling Threads: NPT vs BSPP vs BSPT vs JIC vs ORFS', desc: 'The six thread families on hydraulic quick couplings — how each seals, how to identify them, how to order right.', time: '8 min' },
  { href: '/blog/iso-7241-vs-iso-16028-vs-iso-5675/', title: 'ISO 7241 vs ISO 16028 vs ISO 5675: Interchange & Selection Guide', desc: 'The full standard map: which profiles interchange, how to size, thread and select — plus the 8-step replacement process.', time: '10 min' },
  { href: '/blog/how-to-identify-hydraulic-quick-couplings/', title: 'How to Identify Hydraulic Quick Couplings: A Field Guide', desc: 'Identify any coupling in 5 steps: record the application, inspect both halves, measure critical features, check operating condition, confirm with a drawing.', time: '6 min' },
  { href: '/blog/hydraulic-quick-disconnect-leaking-fixes/', title: 'Hydraulic Quick Disconnect Leaking? Top 5 Causes & Fixes', desc: 'Contamination, seal wear, sleeve damage, wrong valve arrangement, trapped pressure — and the fixes that actually work.', time: '7 min' },
];
---
<Layout title="Blog & Guides | Hydraulic Quick Couplings" description="Selection, interchange and maintenance guides for ISO 7241, ISO 16028 and ISO 5675 hydraulic quick couplings.">
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold text-night-green">Blog &amp; Guides</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight">Buyer's Guides</h1>
      <p class="mt-3 max-w-2xl text-lg text-slate-300">The selection, interchange and maintenance knowledge most coupling suppliers never publish.</p>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <div class="grid gap-6 md:grid-cols-3">
        {posts.map((p) => (
          <a href={p.href} class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-brand-blue hover:shadow-lg">
            <h2 class="text-lg font-bold text-navy-950 group-hover:text-brand-blue">{p.title}</h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{p.desc}</p>
            <span class="mt-4 text-xs font-semibold text-slate-400">{p.time} read</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
