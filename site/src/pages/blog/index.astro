---
import Layout from '../../layouts/Layout.astro';
const posts = [
  { href: '/blog/iso-7241-series-a-vs-series-b/', title: 'ISO 7241 Series A vs Series B: What\'s the Difference?', desc: 'The two ISO 7241 profiles compared — interchange families, 60-second identification, ordering mistakes.', time: '8 min' },
  { href: '/blog/npt-vs-bspp-vs-bspt-vs-jic-vs-orfs/', title: 'Hydraulic Coupling Threads: NPT vs BSPP vs BSPT vs JIC vs ORFS', desc: 'The six thread families on hydraulic quick couplings — how each seals, how to identify them, how to order right.', time: '8 min' },
  { href: '/blog/iso-7241-vs-iso-16028-vs-iso-5675/', title: 'ISO 7241 vs ISO 16028 vs ISO 5675: Interchange & Selection Guide', desc: 'The full standard map: which profiles interchange, how to size, thread and select — plus the 8-step replacement process.', time: '10 min' },
  { href: '/blog/how-to-identify-hydraulic-quick-couplings/', title: 'How to Identify Hydraulic Quick Couplings: A Field Guide', desc: 'Identify any coupling in 5 steps: record the application, inspect both halves, measure critical features, check operating condition, confirm with a drawing.', time: '6 min' },
  { href: '/blog/hydraulic-quick-disconnect-leaking-fixes/', title: 'Hydraulic Quick Disconnect Leaking? Top 5 Causes & Fixes', desc: 'Contamination, seal wear, sleeve damage, wrong valve arrangement, trapped pressure — and the fixes that actually work.', time: '7 min' },
  { href: '/blog/hydraulic-quick-coupling-stuck-fixes/', title: "Hydraulic Quick Coupling Stuck or Won't Lock? Causes & Fixes", desc: 'Trapped pressure, dirt in the groove, worn locking balls, bent sleeve, wrong pair — and the field fix sequence that clears 80% of cases.', time: '8 min' },
  { href: '/blog/steel-vs-brass-vs-stainless-hydraulic-couplings/', title: 'Steel vs Brass vs Stainless Steel Hydraulic Quick Couplings', desc: 'Strength, corrosion, pressure rating, thread behavior and cost — with a selection table that maps each material to its applications.', time: '9 min' },
  { href: '/blog/hydraulic-quick-coupling-o-ring-replacement/', title: 'Hydraulic Quick Coupling O-Ring Replacement: Complete Guide', desc: 'Where the seals sit on ISO 7241, ISO 16028 and ISO 5675, the four failure modes, how to measure a ring, and the full reseal sequence.', time: '9 min' },
  { href: '/blog/hydraulic-quick-coupling-pressure-safety/', title: 'Hydraulic Quick Couplings Under Pressure: Connect-Disconnect Safety Guide', desc: 'Residual pressure, hose whip, oil injection — and the relief tools and connect/disconnect sequences that prevent them.', time: '8 min' },
  { href: '/blog/how-to-size-hydraulic-quick-coupling/', title: 'How to Size a Hydraulic Quick Coupling: Flow, Pressure & the Five Inputs', desc: 'Flow rate, pressure, port thread, fluid and duty cycle — the five-input sizing sequence with flow tables and pressure-drop targets.', time: '10 min' },
  { href: '/blog/hydraulic-quick-couplings-faq/', title: 'Hydraulic Quick Couplings: The 20-Question FAQ', desc: 'Twenty real questions on standards, sizing, threads, seals, leaks, stuck couplings, safety and sourcing — answered with links to the deep guides.', time: '10 min' },
  { href: '/blog/ball-lock-vs-pin-type-vs-sleeve-hydraulic-couplers/', title: 'Ball Lock vs Pin Type vs Sleeve: Hydraulic Coupler Designs Compared', desc: 'Three locking mechanisms compared on speed, flow, pressure, cost — and the application each design fits best.', time: '9 min' },
  { href: '/blog/flat-face-hydraulic-couplings-no-spill-explained/', title: "Why Flat-Face Hydraulic Couplings Don't Leak: ISO 16028 Explained", desc: 'The precise engineering behind near-zero spill, why the flat lapped faces resist contamination, and when the premium pays for itself.', time: '9 min' },
  { href: '/blog/agricultural-hydraulic-couplers-iso-5675-guide/', title: 'Agricultural Hydraulic Couplers (ISO 5675): The Tractor Guide', desc: 'The ISO 5675 standard for tractor outlets and implements — brand matching, retrofit checklist, and how it differs from ISO 7241.', time: '9 min' },
  { href: '/blog/oem-hydraulic-quick-couplings-guide/', title: 'OEM Hydraulic Quick Couplings: From Drawing to Production Run', desc: 'The RFQ five-piece packet, drawing-to-sample-to-production sequence, and the qualification checks that prevent a bad batch.', time: '8 min' },
];
---
<Layout title="Blog & Guides | Hydraulic Quick Couplings" description="Selection, interchange and maintenance guides for ISO 7241, ISO 16028 and ISO 5675 hydraulic quick couplings.">
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold text-night-green">Blog &amp; Guides</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight">Buyer's Guides</h1>
      <p class="mt-3 max-w-2xl text-lg text-slate-300">The selection, interchange and maintenance knowledge most coupling suppliers never publish.</p>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <div class="grid gap-6 md:grid-cols-3">
        {posts.map((p) => (
          <a href={p.href} class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-brand-blue hover:shadow-lg">
            <h2 class="text-lg font-bold text-navy-950 group-hover:text-brand-blue">{p.title}</h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{p.desc}</p>
            <span class="mt-4 text-xs font-semibold text-slate-400">{p.time} read</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
