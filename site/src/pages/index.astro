---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
const products = [
  { href: '/iso-7241-hydraulic-quick-couplings/', title: 'ISO 7241-1 Series A & B', description: 'General-purpose ball-lock quick couplings. The global workhorse for hydraulic lines.', tag: 'ISO 7241' },
  { href: '/flat-face-hydraulic-couplings/', title: 'Flat Face (ISO 16028)', description: 'Low-spill, connect-under-pressure couplers for mobile equipment and safety-critical lines.', tag: 'ISO 16028' },
  { href: '/agricultural-hydraulic-couplings/', title: 'Agricultural (ISO 5675)', description: 'Tractor-to-implement couplings with free flow and long service life in dusty fields.', tag: 'ISO 5675' },
  { href: '/ball-lock-hydraulic-couplings/', title: 'Ball Lock Couplings', description: 'Quick-disconnect sleeve designs with hardened balls and replaceable seals.', tag: 'Ball Lock' },
  { href: '/pin-lock-hydraulic-couplings/', title: 'Pin Lock Couplings', description: 'Positive-locking pin designs for heavy vibration and high-flow circuits.', tag: 'Pin Lock' },
  { href: '/1-2-inch-hydraulic-quick-couplers/', title: '1/2" Couplers', description: 'The most common mobile-equipment size. NPT / BSPP / JIC / ORFS thread options.', tag: '1/2"' },
];
const guides = [
  { href: '/blog/iso-7241-vs-iso-16028-vs-iso-5675/', title: 'ISO 7241 vs ISO 16028 vs ISO 5675', desc: 'Interchange & selection guide — the full standard map.' },
  { href: '/blog/how-to-identify-hydraulic-quick-couplings/', title: 'How to Identify Quick Couplings', desc: 'Field process: measure, match, confirm before you buy.' },
  { href: '/blog/hydraulic-quick-disconnect-leaking-fixes/', title: 'Quick Disconnect Leaking?', desc: 'Top 5 causes and the fixes that actually work.' },
];
---
<Layout>
  <!-- Hero -->
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <p class="text-sm font-semibold text-night-green">ISO 7241-1 · ISO 16028 · ISO 5675</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">Hydraulic Quick Couplings, Sourced Right</h1>
      <p class="mt-5 max-w-2xl text-lg text-slate-300">
        Series A and B ball-lock, flat-face and agricultural quick couplings for mobile equipment, machine tools and industrial lines — with the selection and interchange guidance most suppliers never give you.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/iso-7241-hydraulic-quick-couplings/" class="inline-flex items-center rounded-lg bg-cta-orange px-6 py-3 font-semibold text-white transition hover:bg-orange-600">Browse ISO 7241 Couplings</a>
        <button type="button" data-quote-open class="inline-flex items-center rounded-lg border border-white/25 px-6 py-3 font-semibold text-white transition hover:bg-white/10">Request a Quote</button>
      </div>
    </div>
  </section>

  <!-- 产品网格 -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <h2 class="text-2xl font-extrabold text-navy-950">What We Supply</h2>
      <p class="mt-2 max-w-2xl text-slate-600">Every coupling is available with the end connections you need — NPT, BSPP, BSPT, JIC or ORFS — in steel, stainless and brass.</p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((p) => (
          <ProductCard href={p.href} title={p.title} description={p.description} tag={p.tag} />
        ))}
      </div>
    </div>
  </section>

  <!-- 应用场景 -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <h2 class="text-2xl font-extrabold text-navy-950">Where They Work</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {[
          ['/hydraulic-quick-couplings-for-agriculture/', '🚜', 'Agriculture', 'Tractors, implements, sprayers and balers. ISO 5675 and flat-face couplers for dusty, high-vibration duty.'],
          ['/hydraulic-quick-couplings-for-construction/', '🏗️', 'Construction', 'Excavators, skid steers and loaders. Flat-face ISO 16028 for low spill and connect-under-pressure safety.'],
          ['/hydraulic-quick-couplings-for-industrial/', '🏭', 'Industrial', 'Machine tools, presses and process lines. Series A and B with precise thread and size matching.'],
        ].map(([href, icon, title, desc]) => (
          <a href={href} class="group rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-brand-blue hover:shadow-lg">
            <span class="text-3xl">{icon}</span>
            <h3 class="mt-3 text-lg font-bold text-navy-950 group-hover:text-brand-blue">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 指南 -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <h2 class="text-2xl font-extrabold text-navy-950">Buyer's Guides</h2>
      <p class="mt-2 max-w-2xl text-slate-600">The selection and maintenance knowledge most suppliers don't publish — free to read.</p>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {guides.map((g) => (
          <a href={g.href} class="group rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-brand-blue hover:shadow-lg">
            <h3 class="text-base font-bold text-navy-950 group-hover:text-brand-blue">{g.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{g.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <div class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-center">
        <div>
          <h2 class="text-2xl font-extrabold">Need a Quote by Morning?</h2>
          <p class="mt-2 max-w-xl text-slate-300">Send the standard, size, thread and quantity. We reply within 24 hours with pricing and lead time.</p>
        </div>
        <a href="/contact/" class="inline-flex items-center rounded-lg bg-cta-orange px-6 py-3 font-semibold text-white transition hover:bg-orange-600">Contact Sales</a>
      </div>
    </div>
  </section>
</Layout>
