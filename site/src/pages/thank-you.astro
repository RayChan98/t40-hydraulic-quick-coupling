---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Thank You | Hydraulic Quick Couplings" description="Thank you for your inquiry.">
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 text-center">
      <span class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-night-green/20 text-night-green">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-8 w-8"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
      </span>
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight">Thank You</h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-slate-300">Your inquiry has been received. We reply within 24 hours — usually much faster.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="inline-flex items-center rounded-lg bg-cta-orange px-6 py-3 font-semibold text-white transition hover:bg-orange-600">Back to Home</a>
        <a href="/blog/" class="inline-flex items-center rounded-lg border border-white/25 px-6 py-3 font-semibold text-white transition hover:bg-white/10">Read Our Guides</a>
      </div>
    </div>
  </section>
</Layout>
