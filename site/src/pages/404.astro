---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found | Hydraulic Quick Couplings" description="The page you are looking for does not exist. Browse our ISO 7241, ISO 16028 and ISO 5675 quick coupling guides instead.">
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 text-center">
      <span class="text-6xl font-extrabold tracking-tight text-slate-500">404</span>
      <h1 class="mt-6 text-3xl font-extrabold tracking-tight">Page Not Found</h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-slate-300">The page you are looking for doesn't exist or has moved. Our coupling selection guides are still one click away.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="inline-flex items-center rounded-lg bg-cta-orange px-6 py-3 font-semibold text-white transition hover:bg-orange-600">Back to Home</a>
        <a href="/blog/" class="inline-flex items-center rounded-lg border border-white/25 px-6 py-3 font-semibold text-white transition hover:bg-white/10">Read Our Guides</a>
        <a href="/contact/" class="inline-flex items-center rounded-lg border border-white/25 px-6 py-3 font-semibold text-white transition hover:bg-white/10">Contact Us</a>
      </div>
    </div>
  </section>
</Layout>
